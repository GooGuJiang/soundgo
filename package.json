{
  "name": "soundgo",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "SoundCloud plugin for MyGo Music",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bunx tsc -p tsconfig.json && bunx tsc -p tsconfig.tools.json",
    "test:plugin": "bun test tests/auth.test.ts tests/features.test.ts",
    "test:tooling": "bun test tests/tooling/build.test.ts",
    "test": "bun run build && bun test tests",
    "check": "bun run typecheck && bun run test",
    "version:set": "bun scripts/version.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.8.3"
  }
}
